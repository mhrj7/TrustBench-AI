# The TB-003 smoke fixture and verification commands require no credentials.
# Provider credentials will be documented only when a later task adds a live
# model adapter. Never place real credentials in committed files.

EVE_TELEMETRY_DISABLED=1
TRUSTBENCH_DATA_ROOT=/Volumes/MHRJ/TrustBench-AI/data
TRUSTBENCH_RUNS_ROOT=/Volumes/MHRJ/TrustBench-AI/runs

# Optional: free-tier Gemini for live-model comparison runs (scripts/run-arm-smoke.mjs --model gemini:<model-id>).
# Put the real key only in the gitignored .env file, never in committed files or chat.
GEMINI_API_KEY=
