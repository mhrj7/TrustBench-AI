# Copy to .env (gitignored): cp .env.example .env
# Nothing here is needed for the offline checks (validate, smoke, manifest, report) or for instant runs.
# Live model runs need ONE free-tier provider key below (README.md, "API keys"). Never put a real key in a committed file.

EVE_TELEMETRY_DISABLED=1

# Free-tier Gemini (Google AI Studio) for live runs with --model gemini:<model-id>.
# Put the real key only in the gitignored .env file, never in committed files or chat.
GEMINI_API_KEY=
# Free-tier NVIDIA (build.nvidia.com): the frozen configuration's provider (--model nvidia:<model-id>). Key only in .env.
NVIDIA_API_KEY=

# Live-test service (src/service, docs/live-service.md). All optional; values only in .env or the host's secret store
# (NAME_FILE=/path or /run/secrets/<name> also work). Guests need none of these.
# Operator token for /api/admin (abuse handling).
TRUSTBENCH_ADMIN_TOKEN=
# Require this token before anyone may start a session or a run (closes a deployment that is being abused).
TRUSTBENCH_DEMO_TOKEN=
# Public origin used in emailed links, e.g. https://trustbench.example
TRUSTBENCH_PUBLIC_URL=
# Outgoing mail for account verification and password reset; without a host, mail goes to the local outbox only.
TRUSTBENCH_SMTP_HOST=
TRUSTBENCH_SMTP_PORT=
TRUSTBENCH_SMTP_USER=
TRUSTBENCH_SMTP_PASSWORD=
TRUSTBENCH_MAIL_FROM=
