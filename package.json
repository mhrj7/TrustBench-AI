{
  "name": "trustbench-ai",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "smoke": "node scripts/smoke-environment.mjs",
    "test:budget": "node --test tests/budget.test.ts",
    "verify:budget-pilot": "node scripts/verify-budget-pilot.mjs",
    "test:trace": "node --test tests/trace-contract.test.ts",
    "verify:protocol": "node scripts/verify-protocol.mjs",
    "verify:data": "node scripts/verify-data-manifest.mjs",
    "verify": "npm run typecheck && npm run smoke && npm run test:trace && npm run test:budget && npm run verify:budget-pilot && npm run verify:protocol && npm run verify:data",
    "start": "eve start",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/connect": "2.2.0",
    "ai": "7.0.140",
    "eve": "0.79.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.5.0",
    "npm": "12.0.0"
  },
  "packageManager": "npm@12.0.0"

}
