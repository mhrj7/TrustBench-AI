{
  "name": "trustbench-ai",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "smoke": "node scripts/smoke-environment.mjs",
    "setup": "npm run setup:python && npm run setup:web",
    "setup:python": "sh scripts/setup-python.sh",
    "service": ".venv-tools/bin/python -m uvicorn src.service.app:app --host 127.0.0.1 --port 8080",
    "test:service": ".venv-tools/bin/python -m pytest -q tests/service",
    "test:api-security": ".venv-tools/bin/python -m pytest -q -p no:cacheprovider tests/api-security",
    "setup:web": "npm --prefix web ci --no-audit",
    "trustbench": "sh bin/trustbench",
    "verify:manifest": "sh bin/trustbench manifest > /dev/null",
    "test:cli": ".venv-tools/bin/python -m pytest -q tests/cli",
    "test:smoke-e2e": "node --test tests/smoke/e2e.test.mjs",
    "verify:smoke-suite": "node scripts/run-smoke-suite.mjs",
    "test:model-adapter": "node --test tests/model-adapter.test.ts",
    "verify:model-adapter": "node scripts/verify-model-adapter.mjs",
    "test:tool-service": ".venv-tools/bin/python -m pytest -q src/tools/tests/test_integration.py tests/tools --basetemp=.tool-state/pytest-tools",
    "verify:tool-service": "node scripts/verify-tool-service.mjs",
    "test:baseline-agent": "node --test tests/baseline-agent.test.ts",
    "verify:baseline-agent": "node scripts/verify-baseline-agent.mjs",
    "test:evaluators": ".venv-tools/bin/python -m pytest -q tests/evaluators",
    "verify:evaluators": ".venv-tools/bin/python scripts/verify-evaluators.py",
    "test:pilot-store": "node --test tests/pilot-store.test.ts",
    "pilot:prepare": "node scripts/prepare-baseline-pilot.mjs",
    "pilot:finalize": ".venv-tools/bin/python scripts/finalize-baseline-pilot.py",
    "verify:baseline-pilot": ".venv-tools/bin/python scripts/verify-baseline-pilot.py",
    "test:budget": "node --test tests/budget.test.ts",
    "verify:budget-pilot": "node scripts/verify-budget-pilot.mjs",
    "data:seed-benign": "node scripts/seed-benign-db.mjs",
    "verify:benign-data": "npm run data:seed-benign && node scripts/verify-benign-data.mjs",
    "verify:attack-data": "node scripts/verify-attack-data.mjs",
    "verify:data-splits": "node scripts/verify-data-splits.mjs",
    "test:dataset": "node --test tests/dataset-validation.test.ts",
    "verify:dataset-reset": "node scripts/verify-dataset-reset.mjs",
    "test:trace": "node --test tests/trace-contract.test.ts",
    "verify:protocol": "node scripts/verify-protocol.mjs",
    "verify:data": "node scripts/verify-data-manifest.mjs",
    "verify": "npm run typecheck && npm run smoke && npm run test:smoke-e2e && npm run verify:smoke-suite && npm run test:model-adapter && npm run verify:model-adapter && npm run test:tool-service && npm run verify:tool-service && npm run test:baseline-agent && npm run verify:baseline-agent && npm run test:evaluators && npm run verify:evaluators && npm run test:pilot-store && npm run verify:baseline-pilot && npm run test:trace && npm run test:budget && npm run test:dataset && npm run verify:budget-pilot && npm run verify:benign-data && npm run verify:attack-data && npm run verify:data-splits && npm run verify:holdout2 && npm run verify:manifest && npm run test:cli && npm run test:service && npm run test:api-security && npm run gate:scripted && npm run test:release && npm run verify:dataset-reset && npm run verify:protocol && npm run verify:data && npm run test:gateway && npm run test:provenance && npm run verify:failure-taxonomy && npm run test:policy && npm run test:approval && npm run verify:approval-flow && npm run test:arms && npm run verify:arms-smoke && npm run verify:env-example && npm run test:recovery && npm run verify:recovery && npm run test:no-hardcoding && npm run test:restart && npm run test:faults && npm run test:deploy && npm run test:rollback && npm run test:defenses && npm run test:camel && npm run test:json-extract && npm run test:observability && npm run verify:observability && npm run test:repeats && npm run verify:repeats && npm run test:attribution && npm run test:dashboard && npm run web:data && npm run verify:dashboard && npm run test:web && npm run test:frozen && npm run verify:frozen && npm run verify:workbook",
    "start": "eve start",
    "typecheck": "tsc",
    "test:gateway": "mkdir -p .tool-state && .venv-tools/bin/python -m pytest -q tests/gateway --basetemp=.tool-state/pytest-gateway --junitxml=reports/tb019-gateway-tests.xml && node --test tests/gateway-adapter.test.ts",
    "test:provenance": "mkdir -p .tool-state && .venv-tools/bin/python -m pytest -q tests/provenance --basetemp=.tool-state/pytest-provenance --junitxml=reports/tb020-provenance-tests.xml",
    "verify:failure-taxonomy": ".venv-tools/bin/python scripts/verify-failure-taxonomy.py",
    "test:policy": "mkdir -p .tool-state && .venv-tools/bin/python -m pytest -q tests/policy --basetemp=.tool-state/pytest-policy --junitxml=reports/policy-tests.xml",
    "test:approval": "mkdir -p .tool-state && .venv-tools/bin/python -m pytest -q tests/approval --basetemp=.tool-state/pytest-approval --junitxml=reports/tb022-approval-tests.xml",
    "verify:approval-flow": ".venv-tools/bin/python scripts/verify-approval-flow.py",
    "test:arms": "node --test tests/arms.test.ts",
    "verify:arms-smoke": "node scripts/run-arm-smoke.mjs > /dev/null",
    "verify:env-example": "node scripts/check-env-example.mjs",
    "test:no-hardcoding": "node --test tests/no-hardcoding.test.ts",
    "test:restart": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/tb026-restart-tests.xml tests/restart/restart.test.ts",
    "test:defenses": "node --test tests/defenses.test.ts",
    "bench:gateway": ".venv-tools/bin/python scripts/bench-gateway-overhead.py",
    "test:deploy": ".venv-tools/bin/python -m pytest -q -p no:cacheprovider tests/deploy",
    "test:rollback": ".venv-tools/bin/python -m pytest -q -p no:cacheprovider tests/rollback && node --test tests/rollback/run-store.test.ts",
    "drill:rollback": ".venv-tools/bin/python scripts/rollback-drill.py",
    "test:faults": "mkdir -p reports .tool-state && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/tb040-fault-checkpoint.xml tests/faults/checkpoint.test.ts && .venv-tools/bin/python -m pytest -q -p no:cacheprovider tests/faults --basetemp=.tool-state/pytest-faults --junitxml=reports/tb040-fault-tests.xml",
    "report:faults": ".venv-tools/bin/python scripts/fault-drill.py",
    "test:recovery": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/tb025-recovery-tests.xml tests/recovery/recovery.test.ts tests/recovery/runner.test.ts tests/recovery/integration.test.ts",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "arms:live-local": "node scripts/run-arm-smoke.mjs --model ollama:qwen3.5:9b",
    "summarize:comparison": "node scripts/summarize-defense-comparison.mjs",
    "verify:workbook": ".venv-tools/bin/python scripts/check-workbook.py",
    "test:camel": "node --test tests/camel.test.ts",
    "test:json-extract": "node --test tests/json-extract.test.ts",
    "test:observability": "node --test tests/observability.test.ts",
    "verify:observability": "node scripts/verify-observability.mjs",
    "test:repeats": ".venv-tools/bin/python -m pytest -q tests/evaluation",
    "verify:repeats": ".venv-tools/bin/python scripts/verify-repeats.py > /dev/null",
    "summarize:repeats": ".venv-tools/bin/python scripts/summarize-repeats.py",
    "test:attribution": ".venv-tools/bin/python -m pytest -q tests/analysis",
    "attribution:build": ".venv-tools/bin/python scripts/attribute-failures.py && .venv-tools/bin/python scripts/attribution-accuracy.py && .venv-tools/bin/python scripts/write-attribution-audit.py",
    "review:attribution": ".venv-tools/bin/python -m uvicorn src.review.app:app --host 127.0.0.1 --port 8765",
    "dashboard:index": ".venv-tools/bin/python scripts/dashboard-index.py",
    "test:dashboard": ".venv-tools/bin/python -m pytest -q tests/app",
    "verify:dashboard": ".venv-tools/bin/python scripts/dashboard-index.py --check > /dev/null && .venv-tools/bin/python scripts/verify-dashboard.py",
    "web:data": ".venv-tools/bin/python scripts/export-site-data.py",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm run web:data && npm --prefix web run build",
    "test:web": "npm --prefix web run typecheck && npm --prefix web run test:unit && npm --prefix web run test:e2e",
    "select:frozen": ".venv-tools/bin/python scripts/select-frozen-config.py",
    "verify:frozen": ".venv-tools/bin/python scripts/verify-frozen.py",
    "verify:holdout2": ".venv-tools/bin/python scripts/validate-holdout2.py > /dev/null",
    "gate:dev": ".venv-tools/bin/python scripts/release-gate.py run",
    "gate:scripted": ".venv-tools/bin/python scripts/release-gate-scripted.py > /dev/null",
    "test:release": ".venv-tools/bin/python -m pytest -q tests/release",
    "holdout:run": "node scripts/run-holdout.mjs",
    "holdout2:run": "node scripts/run-holdout.mjs --holdout2",
    "holdout:report": ".venv-tools/bin/python scripts/report-holdout.py",
    "metrics:holdout": ".venv-tools/bin/python scripts/compute-security-utility.py",
    "metrics:holdout2": ".venv-tools/bin/python scripts/compute-security-utility.py --holdout2",
    "uncertainty": ".venv-tools/bin/python scripts/estimate-uncertainty.py",
    "cost:latency": ".venv-tools/bin/python scripts/measure-cost-latency.py",
    "ablations:run": "node scripts/run-ablations.mjs",
    "ablations:analyse": ".venv-tools/bin/python scripts/analyse-ablations.py",
    "deps:analysis": "uv pip install --python .venv-tools/bin/python --require-hashes -r requirements/analysis.lock",
    "test:frozen": ".venv-tools/bin/python -m pytest -q tests/selection",
    "sweep:reliability": "node scripts/run-reliability-sweep.mjs",
    "select:reliability": ".venv-tools/bin/python scripts/select-reliability.py"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@vercel/connect": "2.2.0",
    "ai": "7.0.140",
    "eve": "0.79.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.5.0",
    "npm": "12.0.0"
  },
  "packageManager": "npm@12.0.0"
}
