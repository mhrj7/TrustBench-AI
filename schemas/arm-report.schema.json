{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://trustbench.local/schemas/arm-report-1.1.0.json",
 "title": "TrustBench arm-comparison report 1.1.0 (scripts/run-arm-smoke.mjs)",
 "description": "Paired baseline/defended run report. Required fields are those every 1.1.0 report carries; later additions (model_revision, defended_system, suite, schedule, reliability, trace_file, ablation, confirmatory_holdout) are optional so older reports stay valid. TB-037.",
 "type": "object",
 "required": [
  "attack_channel",
  "attack_rendering",
  "backend_tool_mode",
  "cases",
  "checked_at",
  "config_differences",
  "defended_variant",
  "holdout_excluded_cases",
  "mode",
  "model",
  "prompt_profile",
  "repetitions",
  "schema_version",
  "status",
  "summary",
  "task_id",
  "temperature"
 ],
 "properties": {
  "schema_version": {
   "const": "1.1.0"
  },
  "task_id": {
   "enum": [
    "TB-024",
    "TB-024-live-model"
   ]
  },
  "checked_at": {
   "type": "string",
   "format": "date-time"
  },
  "mode": {
   "enum": [
    "scripted_test",
    "live_model"
   ]
  },
  "model": {
   "type": "string"
  },
  "attack_rendering": {
   "type": "string"
  },
  "attack_channel": {
   "enum": [
    "untrusted_content",
    "trusted_user_control"
   ]
  },
  "backend_tool_mode": {
   "enum": [
    "permissive",
    "contract"
   ]
  },
  "prompt_profile": {
   "type": "string"
  },
  "repetitions": {
   "type": "integer",
   "minimum": 1
  },
  "temperature": {
   "type": [
    "number",
    "null"
   ]
  },
  "defended_variant": {
   "type": "string"
  },
  "defended_system": {
   "type": "string"
  },
  "holdout_excluded_cases": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "type": "string"
  },
  "config_differences": {
   "type": [
    "object",
    "array"
   ]
  },
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "baseline",
     "case_id",
     "defended",
     "differences_attributable_to_gateway",
     "final_state_identical",
