         "final_text": {
          "type": "string"
         },
         "final_tool_calls": {
          "type": "integer"
         },
         "injection_exposed": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "invalid": {
          "type": "boolean"
         },
         "outcome": {
          "enum": [
           "success",
           "failure",
           "timeout",
           "budget_exhausted",
           "cancelled"
          ]
         },
         "tokens": {
          "type": "object",
          "required": [
           "input",
           "output"
          ],
          "properties": {
           "input": {
            "type": "integer"
           },
           "output": {
            "type": "integer"
           }
          }
         },
         "tool_calls": {
          "type": "integer"
         },
         "tool_trace": {
          "type": "array",
          "items": {
           "type": "object",
           "required": [
            "tool",
            "status",
            "error",
            "args"
           ],
           "properties": {
            "tool": {
             "type": "string"
            },
            "status": {
             "type": "string"
            },
            "error": {
             "type": [
              "string",
              "null"
             ]
            },
            "args": {
             "type": "object"
            }
           }
          }
         }
        }
       },
       {
        "type": "object",
        "required": [
         "policy_decisions",
         "approvals"
        ],
        "properties": {
         "policy_decisions": {
          "type": "array"
         },
         "approvals": {
          "type": [
           "array",
           "null"
          ]
         }
        }
       }
      ]
     },
     "case_id": {
      "type": "string"
     },
     "fixture_id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "benign",
       "attack"
      ]
     },
     "attack_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "repetition": {
      "type": "integer",
      "minimum": 1
     },
     "pair_order": {
      "type": "array",
      "items": {
       "enum": [
        "baseline",
        "defended"
       ]
      },
      "minItems": 2,
      "maxItems": 2
     },
     "record_differences": {
      "type": "array"
     },
     "differences_attributable_to_gateway": {
      "type": "boolean"
     },
     "final_state_identical": {
      "type": "boolean"
     },
     "first_request_identical": {
      "type": "boolean"
     },
     "non_tool_messages_identical": {
      "type": "boolean"
     },
     "run_config_identical": {
      "type": "boolean"
     },
     "same_tool_call_sequence": {
      "type": "boolean"
     },
     "settings_identical": {
      "type": "boolean"
     }
    }
   }
  },
  "summary": {
   "type": "object",
   "required": [
    "validity",
    "benign_utility_pass",
    "attacker_goal_achieved",
    "unsafe_committed_effect"
   ],
   "properties": {
    "validity": {
     "type": "object",
     "required": [
