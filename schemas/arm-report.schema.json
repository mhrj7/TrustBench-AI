    "properties": {
     "baseline": {
      "type": "object",
      "required": [
       "elapsed_ms",
       "engaged",
       "evaluation",
       "failures",
       "final_text",
       "final_tool_calls",
       "injection_exposed",
       "invalid",
       "outcome",
       "tokens",
       "tool_calls",
       "tool_trace"
      ],
      "properties": {
       "elapsed_ms": {
        "type": [
         "integer",
         "number"
        ]
       },
       "engaged": {
        "type": "boolean"
       },
       "evaluation": {
        "type": "object",
        "required": [
         "attacker_goal_achieved",
         "evaluator_version",
         "evidence_complete",
         "prohibited_side_effects",
         "reason_codes",
         "security_pass",
         "utility_pass"
        ],
        "properties": {
         "attacker_goal_achieved": {
          "type": "boolean"
         },
         "security_pass": {
          "type": "boolean"
         },
         "utility_pass": {
          "type": "boolean"
         },
         "evidence_complete": {
          "type": "boolean"
         },
         "evaluator_version": {
          "type": "string"
         },
         "prohibited_side_effects": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "reason_codes": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        }
       },
       "failures": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "final_text": {
        "type": "string"
       },
       "final_tool_calls": {
        "type": "integer"
       },
       "injection_exposed": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "invalid": {
        "type": "boolean"
       },
       "outcome": {
        "enum": [
         "success",
         "failure",
         "timeout",
         "budget_exhausted",
         "cancelled"
        ]
       },
       "tokens": {
        "type": "object",
        "required": [
         "input",
         "output"
        ],
        "properties": {
         "input": {
          "type": "integer"
         },
         "output": {
          "type": "integer"
         }
        }
       },
       "tool_calls": {
        "type": "integer"
       },
       "tool_trace": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "tool",
          "status",
          "error",
          "args"
         ],
         "properties": {
          "tool": {
           "type": "string"
          },
          "status": {
           "type": "string"
          },
          "error": {
           "type": [
            "string",
            "null"
           ]
          },
          "args": {
           "type": "object"
          }
         }
        }
       }
      }
     },
     "defended": {
      "allOf": [
       {
        "type": "object",
        "required": [
         "elapsed_ms",
         "engaged",
         "evaluation",
         "failures",
         "final_text",
         "final_tool_calls",
         "injection_exposed",
         "invalid",
         "outcome",
         "tokens",
         "tool_calls",
         "tool_trace"
