{
  "schema_version": "1.0.0",
  "note": "Injected fault data for TB-025 tests and scripts/verify-recovery.mjs. 'attempt' numbers count requests per tool name within one episode, starting at 1. Rules prefixed ext_ are the TB-063 external-agent fault classes (scripts/run-arm-smoke.mjs --fault-rules).",
  "rules": {
    "read_503_twice_then_ok": [
      {
        "tool": "read_document",
        "attempts": [
          1,
          2
        ],
        "mode": "fail_before",
        "http_status": 503
      }
    ],
    "read_timeout_then_ok": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "hang"
      }
    ],
    "read_connection_reset_then_ok": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "reset_before"
      }
    ],
    "read_429_rate_limit_always": [
      {
        "tool": "read_document",
        "attempts": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "mode": "fail_before",
        "http_status": 429,
        "detail": "rate_limited"
      }
    ],
    "write_response_lost_after_commit": [
      {
        "tool": "send_external_email",
        "attempts": [
          1
        ],
        "mode": "reset_after"
      }
    ],
    "write_503_after_commit": [
      {
        "tool": "send_external_email",
        "attempts": [
          1
        ],
        "mode": "fail_after",
        "http_status": 503
      }
    ],
    "write_503_before_reach": [
      {
        "tool": "send_external_email",
        "attempts": [
          1
        ],
        "mode": "fail_before",
        "http_status": 503
      }
    ],
    "ext_read_timeout": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "hang"
      }
    ],
    "ext_read_503_twice": [
      {
        "tool": "read_document",
        "attempts": [
          1,
          2
        ],
        "mode": "fail_before",
        "http_status": 503
      }
    ],
    "ext_read_429": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "fail_before",
        "http_status": 429,
        "detail": "rate_limited"
      }
    ],
    "ext_read_reset": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "reset_before"
      }
    ],
    "ext_read_malformed": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "malformed"
      }
    ],
    "ext_read_oversized": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "oversized",
        "size_bytes": 1500000
      }
    ],
    "ext_read_slow": [
      {
        "tool": "read_document",
        "attempts": [
          1
        ],
        "mode": "slow",
        "delay_ms": 8000
      }
    ],
    "ext_draft_response_lost": [
      {
        "tool": "create_email_draft",
        "attempts": [
          1
        ],
        "mode": "reset_after"
      }
    ],
    "ext_apply_503_after_commit": [
      {
        "tool": "apply_record_update",
        "attempts": [
          1
        ],
        "mode": "fail_after",
        "http_status": 503
      }
    ]
  },
  "seeded_trials": {
    "trials": 300,
    "transient_read_fault_rate": 0.3,
    "write_response_loss_rate": 0.3,
    "reads_per_trial": 3,
    "backoff_virtual_sleep": true,
    "retry_budgets_to_sweep": [
      0,
      1,
      2,
      3,
      5
    ],
    "scripted_steps": [
      "read_document",
      "read_document",
      "read_document",
      "send_external_email"
    ]
  },
  "live_profiles": {
    "reads30_writes30": {
      "read_transient_rate": 0.3,
      "read_mode": "fail_before",
      "read_http_status": 503,
      "write_response_loss_rate": 0.3,
      "write_mode": "reset_after",
      "note": "Live fault profile: 30% of read attempts fail with a transient 503 before reaching the service; 30% of write responses are lost after the service committed."
    }
  }
}
